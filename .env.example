# Kopieren nach ".env" und Werte eintragen.
#
# Fuer Portainer "Git repository"-Stacks: .env wird NICHT automatisch aus dem
# Repo uebernommen (bewusst per .gitignore ausgeschlossen). Trage dieselben
# Variablen stattdessen unter "Environment variables" in der Stack-
# Konfiguration von Portainer ein.

# --- Datenquelle ---
# "modbus"       - direkte Modbus-TCP-Verbindung zum Wechselrichter (Standard)
# "homeassistant"- liest bestehende Sensor-Entities aus Home Assistant aus.
#                  Empfohlen, wenn Home Assistant den Wechselrichter bereits
#                  per Modbus (oder anders) abfragt - die meisten SolarEdge-
#                  Wechselrichter erlauben nur EINE aktive Modbus-TCP-
#                  Verbindung gleichzeitig, ein zweiter Client (dieser
#                  Container) wuerde mit HA um die Verbindung konkurrieren.
DATA_SOURCE=modbus

# --- SolarEdge Wechselrichter (nur bei DATA_SOURCE=modbus) ---
# IP-Adresse oder Hostname des SE10K im lokalen Netz.
# Modbus TCP muss am Wechselrichter aktiviert sein:
# Display/SetApp -> Communication -> Modbus TCP -> Enable
SOLAREDGE_HOST=192.168.1.50
SOLAREDGE_PORT=1502
# Modbus Unit/Slave-ID - bei einem einzelnen Wechselrichter i.d.R. 1
SOLAREDGE_UNIT_ID=1
SOLAREDGE_TIMEOUT=10

# --- Home Assistant (nur bei DATA_SOURCE=homeassistant) ---
# Long-Lived Access Token: HA -> Profil -> ganz unten "Long-Lived Access Tokens"
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=changeme
HOMEASSISTANT_TIMEOUT=10
# Entity-IDs deiner SolarEdge-Sensoren in Home Assistant (Einstellungen ->
# Geraete & Dienste -> Entitaeten, oder Entwicklerwerkzeuge -> Zustaende).
# Einheiten werden automatisch erkannt und umgerechnet (kW->W, kWh->Wh, ...).
HA_ENTITY_POWER=sensor.solaredge_ac_power
HA_ENTITY_ENERGY_TOTAL=sensor.solaredge_lifetime_energy
HA_ENTITY_TEMPERATURE=sensor.solaredge_temperature
HA_ENTITY_VOLTAGE=sensor.solaredge_voltage_l1
# Optional: Status-Entity (z.B. "sensor.solaredge_status"). Wird sowohl als
# Text ("Sleeping", "Producing", ...) als auch als numerischer SunSpec-Code
# (1-8) unterstuetzt. Wenn gesetzt, greift SKIP_STATUSES (siehe unten) auch
# bei DATA_SOURCE=homeassistant. Ist die Entity nicht erreichbar, wird das
# Update trotzdem gesendet (nur ohne Status).
HA_ENTITY_STATUS=sensor.solaredge_status

# --- PVOutput ---
# https://pvoutput.org/account.jsp -> API Settings
PVOUTPUT_API_KEY=changeme
# https://pvoutput.org/list.jsp?p=your_system -> System Id in der URL/Uebersicht
PVOUTPUT_SYSTEM_ID=changeme

# --- Verhalten ---
# Sekunden zwischen Uploads. PVOutput erlaubt ohne Donation-Account
# minimal 300 Sekunden (5 Minuten).
INTERVAL_SECONDS=300
PVOUTPUT_INCLUDE_TEMPERATURE=true
PVOUTPUT_INCLUDE_VOLTAGE=true

# Komma-getrennte Liste von Wechselrichter-Status, bei denen KEIN Update an
# PVOutput gesendet wird. Standard: "Sleeping" (nachts) - damit werden keine
# sinnlosen 0W-Updates hochgeladen. Bei DATA_SOURCE=modbus immer verfuegbar;
# bei DATA_SOURCE=homeassistant nur wenn HA_ENTITY_STATUS gesetzt ist.
# Moegliche Werte: Off, Sleeping, Starting, Producing, Producing (Throttled),
# Shutting Down, Fault, Standby
SKIP_STATUSES=Sleeping

# Zeitzone fuer die an PVOutput gemeldeten Zeitstempel
TZ=Europe/Berlin

# DEBUG fuer mehr Details, z.B. beim Ersteinrichten
LOG_LEVEL=INFO
# Sprache der Log-Ausgaben: "de" oder "en"
LOG_LANGUAGE=de

# Auf true setzen, um Werte nur zu loggen statt an PVOutput zu senden
DRY_RUN=false
